<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{8B4A2C71-5D3E-4F16-9A28-7C0E1B4D6F93}</ProjectGuid>
        <MainSource>ConnectionTests.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>19.2</ProjectVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DependencyCheckOutputName>.\$(Platform)\$(Config)\ConnectionTests.exe</DCC_DependencyCheckOutputName>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_DcuOutput>.\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
        <DCC_UnitSearchPath>..\src;..\src\Query;..\modules\log;..\..\DUnitX\Source;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Define>CONSOLE_TESTRUNNER;$(DCC_Define)</DCC_Define>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <DCC_HintsAndWarnings>false</DCC_HintsAndWarnings>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RemoteDebug>true</DCC_RemoteDebug>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Teste.Sentinela.pas" />
        <DCCReference Include="Teste.Ambiente.pas" />
        <DCCReference Include="Teste.BancoTemporario.pas" />
        <DCCReference Include="Teste.IniTemporario.pas" />
        <DCCReference Include="Teste.Caracterizacao.Conexao.pas" />
        <DCCReference Include="Teste.Caracterizacao.ArquivoIni.pas" />
        <DCCReference Include="Teste.Caracterizacao.Gerenciador.pas" />
        <DCCReference Include="Teste.Caracterizacao.Query.pas" />
        <DCCReference Include="Teste.Excecoes.pas" />
        <DCCReference Include="Teste.Conexao.pas" />
        <DCCReference Include="Teste.ArquivoIni.Resultado.pas" />
        <DCCReference Include="Teste.Gerenciador.Log.pas" />
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
    <PropertyGroup>
        <PreBuildEvent><![CDATA[]]></PreBuildEvent>
    </PropertyGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">ConnectionTests.dpr</Source>
                </Source>
            </Delphi.Personality>
        </BorlandProject>
    </ProjectExtensions>
</Project>
